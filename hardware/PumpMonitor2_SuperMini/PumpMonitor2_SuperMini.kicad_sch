	)
	(text "+------------------+-------------------+--------------------+-----------------------------------------------------+\n| Signalname       | Alter Pin         | Neuer Pin          | Wichtiger Layout- / Schaltungshinweis               |\n| im Schaltplan    | (ESP32-S2)        | (ESP32-C3-Mini)    |                                                     |\n+------------------+-------------------+--------------------+-----------------------------------------------------+\n| PUMP_CHECK       | IO5  (Pin 10)     | GPIO 0             | Bleibt analog (ADC1_CH0). Spannungsteiler nutzen!   |\n| AKKU_CHECK       | IO6  (Pin 11)     | GPIO 1             | Bleibt analog (ADC1_CH1).                           |\n| POWER_CHECK      | IO18 (Pin 25)     | GPIO 3             | Wird digital gelesen. Spannungsteiler auf max 3.3V! |\n| BTN_DOWN         | IO4  (Pin 9)      | GPIO 4             | Taster gegen GND. Interner Pull-Up aktiv.           |\n| BTN_UP           | IO3  (Pin 8)      | GPIO 5             | Boot-Pin! Taster gegen GND (beim Booten ungedrueckt)|\n| DIS_SCK          | IO36 (Pin 17)     | GPIO 20            | Hardware-SPI Clock.                                 |\n| DIS_MOSI         | IO35 (Pin 16)     | GPIO 21            | Hardware-SPI MOSI.                                  |\n| DIS_CS           | IO34 (Pin 15)     | GPIO 6             | Display Chip Select.                                |\n| DIS_DC           | IO33 (Pin 14)     | GPIO 7             | Display Data/Command.                               |\n| DIS_RST          | IO12 (Pin 19)     | GPIO 10            | Display Reset.                                      |\n| DIS_BUSY         | IO11 (Pin 18)     | GPIO 9*            | Display Busy.                                       |\n+------------------+-------------------+--------------------+-----------------------------------------------------+\n| *strapping       |                   | GPIO 2, GPIO 8     |"
		(exclude_from_sim no)
		(at 146.05 107.442 0)
		(effects
			(font
				(face "Courier 10 Pitch")
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "992c7c62-4d82-49bf-90ef-e21fa603f6c1")
	)
